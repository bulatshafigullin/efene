## line comment
@const(TTL) -> 12 * 3600
@const(LIMIT) -> 10

fn ttl = #m TTL

fn clock = erlang.monotonic_time(second)

fn clock_for_test = clock()

fn double(X) = X * 2

fn is_big @guard case N: N > #m LIMIT end

fn big
  case N when is_big(N): yes  ## trailing comment
  else: no
end

fn greet
  case Name, Greeting := 'hello', Punct := '!':
    '#{Greeting}, #{Name}#{Punct}'
end

fn greet_list case N: "n=#{N} f=#{1.5} a=#{abc}" end

fn cfg
  case K:
    match K:
      case a: ok(1)
      case b: err(nope)
    end
end

fn check
  case A, B:
    with (ok, X) = cfg(A); (ok, Y) = cfg(B):
      X + Y
    end
end

fn check2
  case A, B:
    with (ok, X) = cfg(A); (ok, Y) = cfg(B):
      X + Y
    else:
      failed
    end
end

fn check3
  case A, B:
    with (ok, X) = cfg(A); (ok, Y) = cfg(B):
      X + Y
    else
      case (error, nope): nope_found
      else: other
    end
end

fn safe
  case X: try! binary_to_integer(X) else -1
end

fn piped
  case L:
    match L -> lists.reverse():
      case H :: _: H
      else: none
    end
end

fn len_ok case X when is_integer(X): ok(X) end

fn own_ok
  case X: (mine, X)
end

fn comment_in_string case: "not ## a comment" end

fn escaped case: 'literal \#{x}' end

fn get_id(P) = P.id
fn get_deep(P) = P.user.name
fn get_key(M, K) = M[K]
fn get_default(M) = M['name', nil]
fn mixed(M) = M['user'].name
fn has_id case P when P.id > 1: big else: small end

fn arities
  case: zero
  case A, 0: (two_zero, A)
  case A: (one, A)
  case A, B: (two, A, B)
end

fn heredoc
  case Name:
    """
      Hello #{Name},
        indented "quoted"
      bye
    """
end

fn heredoc_bin
  case:
    '''
    raw 'q'
    '''
end

fn update_deep(P) = P.user#{name: 'new'}
fn update_var(P) = P#{a: 1}

fn with_guard
  case X:
    with (ok, N) = X when N > 10: big
    else: small
    end
end

fn lits case: '#{1}-#{2.5}-#{abc}' end

fn spec_sugar
  @spec(ok(integer())) -> ok(atom()) or err(term())
  case X: ok(X)
end

fn reserved_words case: (def, cond, let, of, if) end

@type(user) -> {id: integer(), name: binary() or nil, extra: map()}

fn no_args_spec
  @spec -> ok(user())
  case: ok({})
end

@assert_ct(1 + 1 is 2)

fn q1
  case X:
    Body = lookup(X)?
    Body * 2
end

fn lookup
  case 0: err(zero)
  case N: ok(N)
end

fn q_bare
  case X:
    lookup(X)?
    done
end

fn g1
  case X:
    guard (ok, V) = lookup(X) else err(nope)
    guard V > 5 else err(small)
    V
end

fn d1
  case T:
    defer ets.delete(T)
    ets.insert(T, (a, 1))
    ets.lookup(T, a)
end

fn pun(Id, UserName) = {id:, user_name:}
fn pun_match
  case {id=, user_name=}: (Id, UserName)
end

fn sq = lists.map(fn(X) = X * X, 1..4)
fn in_test(X) = X in [1, 2, 3]
fn in_range(X) = X in 1..10
fn in_guard
  case X when X in [a, b]: yes
  case X when X in 5..9: mid
  else: no
end

fn lp
  case:
    loop (I = 0, Acc = []):
      when I == 3: lists.reverse(Acc)
      else: recur(I + 1, I :: Acc)
      end
    end
end

fn rt(X) = lookup(X) => step(2) => step(10)
fn step(V, N) = ok(V + N)
fn bad_step(V) = err(boom)
fn rt2(X) = lookup(X) => bad_step() => step(1)

fn opt_chain(P) = P?.user?.name
fn place(Id) = Id -> lists.seq(1, _)
