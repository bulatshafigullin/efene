@const(CACHE_SECONDS) -> 15
@const(COUNTS_CACHE_SECONDS) -> 5
@const(TTL_SECONDS) -> 12 * 3600
@const(TABLE) -> moderation_staff_sessions

@type(principal) -> {id: binary(), roles: [binary()], name: binary() or nil}
@export_type(principal/0)

fn ttl_seconds
  @doc("Cookie lifetime, for Max-Age -- Django's session expires on the same clock.")
  @spec -> pos_integer()
  case: #m TTL_SECONDS
end

fn login
  @doc("""
    Sign in through Django. Every bad login is invalid_credentials alike, so the
    console can't tell a guesser which half was wrong.
    """)
  @spec(binary(), binary(), map()) ->
    (ok, binary(), principal()) or
    err(invalid_credentials or forbidden or unavailable) or
    (error, rate_limited, pos_integer())
  case Login, Password, Meta := {} when is_binary(Login), is_binary(Password):
    Ip = maps.get(ip, Meta, undefined)
    match moderation.login_throttle.check(Ip, Login):
      case err(RetryAfter): (error, rate_limited, RetryAfter)
      case ok:
        match django("login", {'login': Login, 'password': Password}):
          case ok({'session' = Session} = Body) when is_binary(Session):
            open_session(Login, Ip, Session, principal_from(Body))
          case err(invalid_credentials):
            moderation.login_throttle.failure(Ip, Login)
            moderation.log.event(staff_login_failed, {ip: Ip}, warning)
            err(invalid_credentials)
          case err(Reason): err(Reason)
          else: err(unavailable)
        end
    end
end

fn open_session
  case _, _, Session, {roles = []}:
    django("logout", {'session': Session})
    err(forbidden)
  case Login, Ip, Session, Principal:
    moderation.login_throttle.success(Login)
    remember(Session, Principal)
    audit(Principal.id, "staff_login", {ip: Ip})
    (ok, Session, Principal)
end

fn principal
  @doc("The principal behind a cookie value, or error (unknown, ended, or Django unreachable).")
  @spec(binary() or nil) -> ok(principal()) or error
  case Session when is_session(Session):
    match cached(Session):
      case ok(_) = Hit: Hit
      case miss:
        with ok({'sub' = _} = Body) = django("session", {'session': Session}):
          Principal = principal_from(Body)
          remember(Session, Principal)
          ok(Principal)
        else: error
        end
    end
  else: error
end

fn counts
  @doc("""
    The tab badges of the console in one answer, cached a few seconds.
    A session that is not a moderator's gets error, as in principal/1.
    """)
  @spec(binary() or nil) -> ok(map()) or error or err(unavailable)
  case Session when is_session(Session):
    with ok({roles = [_ :: _]}) = principal(Session):
      Key = counts_key(Session)
      match lookup(Key):
        case ok(_) = Hit: Hit
        case miss:
          match django("counts", {'session': Session}):
            case ok(Body):
              store(Key, Body, #m COUNTS_CACHE_SECONDS)
              ok(Body)
            case err(invalid_credentials): error
            case err(_): err(unavailable)
          end
      end
    else: error
    end
  else: error
end

fn logout
  @doc("End the session. Idempotent; a failure to reach Django is logged, never raised.")
  @spec(binary() or nil) -> ok
  case Session when is_session(Session):
    Who = cached(Session)
    forget(Session)
    try! ets.delete(#m TABLE, counts_key(Session)) else ok
    match django("logout", {'session': Session}):
      case ok(_): ok
      case Other:
        moderation.log.event(staff_logout_unconfirmed, {result: inspect(Other)}, error)
    end
    with ok(P) = Who: audit(P.id, "staff_logout", {}) end
    ok
  else: ok
end

fn sweep
  @spec -> ok
  case:
    Now = clock()
    try! ets.select_delete(#m TABLE, [((`_`, `_`, `$1`), [(`<`, `$1`, Now)], [true])]) else ok
    ok
end

fn reset
  @spec -> ok
  case:
    try! ets.delete_all_objects(#m TABLE) else ok
    ok
end

fn is_session @guard case S: is_binary(S) and S != '' end

fn django
  @doc("""
    One call to Django: ok(Body) on 200, the console-level errors for the
    statuses Django uses on purpose, unavailable for anything else (down,
    misconfigured, a 5xx) -- which must not read as wrong password.
    Only Django's own 401 is wrong login; a 400 never reached the check.
    """)
  @spec(binary(), map()) -> ok(map()) or err(invalid_credentials or forbidden or unavailable)
  case Action, Payload:
    with ok(Base) = config(staff_url); ok(Key) = config(internal_api_key):
      post(Action, Payload, Base, Key)
    else: err(unavailable)
    end
end

fn post
  case Action, Payload, Base, Key:
    Opts = [(url, string.trim(Base, trailing, "/") ++ "/" ++ Action), (retry, false),
            (receive_timeout, 10000), (headers, [('x-internal-key', Key)])]
    Response = moderation.http.new(Opts) -> req.post([(json, Payload)])
    match Response:
      case ok({status = 200, body = Body}) when is_map(Body): ok(Body)
      case ok({status = 401}): err(invalid_credentials)
      case ok({status = 403}): err(forbidden)
      case Other:
        moderation.log.event(staff_django_unavailable,
          {action: Action, result: inspect(Other)}, error)
        err(unavailable)
    end
end

fn principal_from(Body) =
  {id: id_string(Body['sub']), name: Body['name', nil],
   roles: wrap(Body['roles', []])}

fn id_string
  case I when is_integer(I): integer_to_binary(I)
  case B: B
end

fn wrap
  case nil: []
  case L when is_list(L): L
  case X: [X]
end

fn config(Key) =
  match application.get_env(moderation, Key):
    case ok(V) when is_binary(V), V != '': ok(V)
    else: error
  end

fn clock = erlang.monotonic_time(second)
fn cache_key(Session) = crypto.hash(sha256, Session)
fn counts_key(Session) = cache_key('counts:#{Session}')
fn cached(Session) = lookup(cache_key(Session))
fn remember(Session, Principal) = store(cache_key(Session), Principal, #m CACHE_SECONDS)
fn forget(Session) = try! ets.delete(#m TABLE, cache_key(Session)) else ok

fn lookup
  case Key:
    Now = clock()
    try!
      match ets.lookup(#m TABLE, Key):
        case [(_, Principal, Until)] when Until >= Now: ok(Principal)
        else: miss
      end
    else miss
end

fn store(Key, Value, Seconds) =
  try! ets.insert(#m TABLE, (Key, Value, clock() + Seconds)) else ok

fn audit(UserId, Action, Details) =
  moderation.repo.insert(moderation.schemas.access_log.new(
    {moderator_id: UserId, action: Action, details: Details}))

fn inspect(X) = io_lib.format("~P", [X, 3])
