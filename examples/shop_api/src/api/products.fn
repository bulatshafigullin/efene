@import(orm.query, [filter/2, select_related/2])

fn route case: ("/products", #i module, {}) end

fn init
  @doc("cowboy handler for GET /products")
  case Req, State:
    match cowboy_req.method(Req):
      case 'GET': (ok, list_products(Req), State)
      case _: (ok, api.http.error(405, 'method not allowed', Req), State)
    end
end

fn list_products
  case Req:
    Base = models.product.objects() ->
      filter({active: true}) ->
      select_related([category])
    Params = cowboy_req.parse_qs(Req)
    match orm.filterset.apply(Base, catalog.product_filters.filterset(), Params):
      case (ok, Query, Pagination):
        Db = shop.db.conn()
        Rows = orm.repo.all(Db, orm.filterset.paginate(Query, Pagination))
        Body = {count: orm.repo.count(Db, Query),
                page: maps.get(page, Pagination),
                page_size: maps.get(page_size, Pagination),
                results: (for Row in Rows: product_json(Row) end)}
        api.http.json(200, Body, Req)
      case (error, Errors):
        api.http.json(400, {errors: maps.from_list(Errors)}, Req)
    end
end

fn product_json
  case Row:
    {id: maps.get(id, Row),
     name: maps.get(name, Row),
     description: maps.get(description, Row),
     price: api.http.money(maps.get(price_cents, Row)),
     stock: maps.get(stock, Row),
     category: category_json(maps.get(category, Row))}
end

fn category_json
  case nil: null
  case Category: {slug: maps.get(slug, Category), name: maps.get(name, Category)}
end
